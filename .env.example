ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6

# Test grubu erisim kapisi: uygulamayi acmadan once bu kod isteniyor.
ACCESS_CODE=degistir-beni

# /admin sayfasi icin ayri, daha az kisiyle paylasilacak kod.
ADMIN_ACCESS_CODE=degistir-beni-de

# Auth.js oturum/JWT imzalama anahtari — `openssl rand -hex 32` ile uret.
AUTH_SECRET=

# Resend (magic link e-postasi icin) — resend.com hesabindan alinir.
RESEND_API_KEY=
AUTH_EMAIL_FROM=Bir Oda Bir Esya <no-reply@sizin-domaininiz.com>

# Optional: restrict the entire app to this verified email; disables guest access.
PRIVATE_OWNER_EMAIL=

# Session V2 (identity-aware true-user-inactivity policy) — REQUIRED, the app
# fails closed (503) without it. Only "staging-idle-v2" exists today (guest
# warning/timeout 3m/5m, account 5m/10m). Production has no selected policy
# yet — do not set this to any value on a production deployment.
SESTIA_SESSION_POLICY=staging-idle-v2
